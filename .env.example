# Copiar a .env y completar con la key del proveedor elegido.
# El .env NO se sube al repo (está en el .gitignore).

# openai | anthropic | gemini
LLM_PROVIDER=gemini

# Gemini tiene free tier y no pide tarjeta: se saca gratis en https://aistudio.google.com/apikey
GOOGLE_API_KEY=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opcionales
# LLM_MODEL=gemini-flash-latest
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=1024
